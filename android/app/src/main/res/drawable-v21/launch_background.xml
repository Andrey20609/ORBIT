<?xml version="1.0" encoding="utf-8"?>
<!-- Static ORBIT splash: unified sampled background with the centred
     approved artwork (~320 dp). No animation. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/orbit_splash_background"/>
    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="center"
        android:drawable="@drawable/orbit_splash_mark"/>
</layer-list>
