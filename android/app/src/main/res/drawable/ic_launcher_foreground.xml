<?xml version="1.0" encoding="utf-8"?>
<!-- ORBIT launcher foreground (adaptive icon), rasterised equivalent of
     assets/branding/orbit_icon_master.svg. Primary elements stay inside the
     66/108 adaptive safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Thin tilted orbit (subtle decorative line) -->
    <path
        android:pathData="M 20.42,66.06 A 34.81,13.5 0 1 0 87.58,41.94"
        android:strokeColor="#8A8FBC"
        android:strokeAlpha="0.5"
        android:strokeWidth="0.84"
        android:fillColor="#00000000"/>

    <!-- Soft satellite glow (decorative) -->
    <path
        android:pathData="M 70.19,35.46 m -9.07,0 a 9.07,9.07 0 1 1 18.14,0 a 9.07,9.07 0 1 1 -18.14,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="70.19"
                android:centerY="35.46"
                android:gradientRadius="9.07"
                android:startColor="#55EAF0FF"
                android:endColor="#00EAF0FF"/>
        </aapt:attr>
    </path>

    <!-- Broken ring with the blue->violet gradient -->
    <path
        android:pathData="M 71.13,36.86 A 24.25,24.25 0 1 0 54.0,29.74"
        android:strokeWidth="4.64"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#6C8CFF"
                android:endColor="#9B6CFF"/>
        </aapt:attr>
    </path>

    <!-- Satellite -->
    <path
        android:fillColor="#EAF0FF"
        android:pathData="M 70.19,35.46 m -3.16,0 a 3.16,3.16 0 1 1 6.32,0 a 3.16,3.16 0 1 1 -6.32,0"/>
</vector>
