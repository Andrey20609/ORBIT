<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: the app adaptive icon (the approved
         artwork) on the unified sampled background. Static, no animation.
         postSplashScreenTheme is an androidx-only attr and is intentionally
         not used; the Flutter embedding switches to NormalTheme via
         meta-data, and NormalTheme uses the same background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/orbit_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/orbit_icon_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/orbit_splash_background</item>
    </style>
</resources>
